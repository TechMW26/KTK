{
  "name": "kill-the-king-game",
  "version": "1.0.0",
  "private": true,
  "description": "A mobile-first strategy and bluff card game.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vite build",
    "build:node": "cross-env NITRO_PRESET=node vite build",
    "preview:node": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:rules": "node --experimental-strip-types scripts/rules.test.ts",
    "test:bot": "node --experimental-strip-types scripts/bot.test.ts",
    "test:flow": "node --experimental-strip-types scripts/flow.test.ts",
    "test:progression": "node --experimental-strip-types scripts/progression.test.ts",
    "test:logic": "node --experimental-strip-types scripts/logic.test.ts",
    "test:single-source": "node --experimental-strip-types scripts/single-source.test.ts",
    "test:friends": "node --experimental-strip-types scripts/friends.test.ts",
    "test:matchmaking": "node --experimental-strip-types scripts/matchmaking.test.ts",
    "test:header-actions": "node --experimental-strip-types scripts/header-actions.test.ts",
    "test:facebook-auth": "node --experimental-strip-types scripts/facebook-auth.test.ts",
    "test:rooms": "node --experimental-strip-types scripts/room-verdicts.test.ts",
    "test": "npm run typecheck && npm run test:rules && npm run test:bot && npm run test:flow && npm run test:progression && npm run test:logic && npm run test:single-source && npm run test:friends && npm run test:matchmaking && npm run test:header-actions && npm run test:facebook-auth",
    "app:build": "node scripts/build-capacitor-web.mjs",
    "app:sync": "cap sync android",
    "app:apk": "cd android && gradlew.bat assembleDebug",
    "app:build-run": "node scripts/build-capacitor-web.mjs && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "firebase": "^11.0.0",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
