{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || root.child('rooms').child($code).child('players').child(auth.uid).exists())",
        "secrets": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('order').val() != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matchmakingHost": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "matchmakingPairs": {
      ".read": "auth != null",
      "$pair": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friends": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
