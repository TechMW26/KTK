{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || data.child('players').child(auth.uid).exists())",

        "hostId": { ".write": "!data.exists() || data.val() === auth.uid" },
        "code": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8" },

        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth.uid === $uid && (!data.exists() || !newData.hasChild('isHost') || newData.child('isHost').val() === data.child('isHost').val())"
          }
        },

        "secrets": {
          ".read": false,
          ".write": false,
          "$uid": {
            ".read": "auth.uid === $uid",
            ".write": "auth.uid === $uid",
            "$k": {
              ".read": "auth.uid === $uid",
              ".write": "auth.uid === $uid"
            }
          }
        },

        "game": {
          ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        }
      }
    },
    "users": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "emailVerified": { ".validate": "newData.isBoolean()" },
        "deletedAt": {
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "providers": {
          ".validate": "newData.hasChildren()"
        },
        "$other": { ".validate": false }
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "matchmakingHost": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "matchmakingPairs": {
      ".read": "auth != null",
      "$pair": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
