{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || data.child('players').child(auth.uid).exists())",

        "hostId": { ".write": "!data.exists() || data.val() === auth.uid" },
        "code": { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8" },

        "order": {
          "$seat": { ".write": "auth != null" }
        },
        "status": {
          ".write": "auth != null"
        },
        "settings": {
          ".write": "auth != null"
        },
        "updatedAt": {
          ".write": "auth != null"
        },

        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth.uid === $uid && (!data.exists() || !newData.hasChild('isHost') || newData.child('isHost').val() === data.child('isHost').val())"
          }
        },

        "secrets": {
          ".read": false,
          ".write": false,
          "$uid": {
            ".read": "auth.uid === $uid",
            ".write": "auth.uid === $uid",
            "$k": {
              ".read": "auth.uid === $uid",
              ".write": "auth.uid === $uid"
            }
          }
        },

        "game": {
          ".read": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        }
      }
    },
    "users": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "emailVerified": { ".validate": "newData.isBoolean()" },
        "deletedAt": {
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "providers": {
          ".validate": "newData.hasChildren()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length <= 2"
        },
        "dateOfBirth": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/))"
        },
        "matchesPlayed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && (!data.exists() || newData.val() >= data.val())"
        },
        "matchesWon": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && (!data.exists() || newData.val() >= data.val())"
        },
        "$other": { ".validate": false }
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "matchmakingHost": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "matchmakingPairs": {
      ".read": "auth != null",
      "$pair": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "friends": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".validate": "newData.hasChildren(['uid', 'name', 'addedAt']) && newData.child('uid').val() === $friendUid",
          "uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "addedAt": { ".validate": "newData.isNumber()" },
          "lastSeenAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeenAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
