NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=killtheking-94396.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://killtheking-94396-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=killtheking-94396
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=killtheking-94396.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=697808148848
NEXT_PUBLIC_FIREBASE_APP_ID=1:697808148848:web:eab7874ec29d55e51dd7b5
